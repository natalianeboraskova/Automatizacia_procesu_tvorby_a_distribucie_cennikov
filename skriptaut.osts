{"version":"0.3.0","body":"function main(workbook: ExcelScript.Workbook) {\r\n\t// Add a new worksheet\r\n\tlet sheet1 = workbook.addWorksheet();\r\n\tlet selectedSheet = workbook.getActiveWorksheet();\r\n\t// Paste to range A1 on sheet1 from range A1:G17 on selectedSheet\r\n\tsheet1.getRange(\"A1\").copyFrom(selectedSheet.getRange(\"A1:G17\"), ExcelScript.RangeCopyType.all, false, false);\r\n\t// Auto fit the columns of range C:C on sheet1\r\n\tsheet1.getRange(\"C:C\").getFormat().autofitColumns();\r\n\t// Set width of column(s) at range B:B on sheet1 to 121.5\r\n\tsheet1.getRange(\"B:B\").getFormat().setColumnWidth(121.5);\r\n // Set width of column(s) at range E:E on sheet1 to 92.25\r\n sheet1.getRange(\"E:E\").getFormat().setColumnWidth(92.25);\r\n\r\n // Dnešný dátum + 2 dni\r\n let date = new Date();\r\n date.setDate(date.getDate() + 2);\r\n\r\n // Formát napr. 19.9.\r\n let sheetName = `${date.getDate()}.${date.getMonth() + 1}.`;\r\n\r\n sheet1.setName(sheetName);\r\n}","description":"","noCodeMetadata":null,"parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}